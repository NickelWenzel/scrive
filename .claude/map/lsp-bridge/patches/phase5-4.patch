+
+/// The client does not apply server-initiated edits, and says so.
+#[test]
+fn apply_edit_is_declined() {
+    let (mut client, _) = running(Client::builder(), incremental());
+    let response = answer(&mut client, "workspace/applyEdit", json!({"edit": {}}));
+    assert_eq!(
