+/// Opens `doc` on `client` as `uri`.
+fn open_as(client: &mut Client, doc: &Document, uri_text: &str) {
+    let _ = client
+        .open(&doc.snapshot(), &uri(uri_text), "rust")
+        .expect("opens");
+}
