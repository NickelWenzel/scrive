+/// A signature request at `column` on line 0 of `doc`, inside the call whose `(` is at `call`,
+/// under a fresh ticket.
+fn signature_request(
+    tickets: &mut Counter,
+    doc: &Document,
+    column: u32,
+    call: Option<u32>,
