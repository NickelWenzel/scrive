+fn signature_help_request(id: i64, column: u32) -> Value {
+    json!({"jsonrpc": "2.0", "id": id, "method": "textDocument/signatureHelp", "params": {
+        "textDocument": {"uri": "file:///a.rs"},
+        "position": {"line": 0, "character": column},
+    }})
