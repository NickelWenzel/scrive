+    from_server(json!({"jsonrpc": "2.0", "id": id, "result": {
+        "signatures": [{"label": "foo(a: i32, b: i32)", "parameters": [{"label": "a: i32"}, {"label": "b: i32"}]}],
+        "activeParameter": 0,
+    }}))
