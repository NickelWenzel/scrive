+    /// A signature request names the innermost `(` still open at the caret,
+    /// not a call that has closed before it.
+    #[test]
+    fn signature_request_names_the_innermost_open_paren() {
+        let mut ed = CodeEditor::new("");
+        for c in ['f', '(', 'g', '(', 'x', ')', ','] {
+            act(&mut ed, Action::Type(c));
+        }
