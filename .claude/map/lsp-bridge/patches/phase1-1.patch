+    /// Snapshot point conversion agrees with the buffer and clamps rows and
+    /// columns the way its docs state.
+    #[test]
+    fn snapshot_points_round_trip_and_clamp_like_the_buffer() {
+        let b = buf("ab\ncd\n");
+        let s = b.snapshot();
+        for o in 0..=s.len() {
+            let p = s.offset_to_point(o);
+            assert_eq!(p, b.offset_to_point(o), "offset {o} converts like the buffer");
+            assert_eq!(s.point_to_offset(p), o, "offset {o} round-trips");
+        }
+        assert_eq!(s.point_to_offset(Point::new(9, 0)), 6, "a row past the end clamps to the last line");
+        assert_eq!(s.point_to_offset(Point::new(0, 99)), 2, "a column past the end clamps to the line end");
+        assert_eq!(s.offset_to_point(99), Point::new(2, 0), "an offset past the end clamps to the end");
+    }
+
+    /// Chunks over any range concatenate to that range's slice, with the range
+    /// clipped outward to char boundaries.
+    #[test]
+    fn snapshot_chunks_concatenate_to_the_slice() {
+        let text: String = (0..80).map(|i| if i % 3 == 0 { "ab😀\n" } else { "xé" }).collect();
+        let b = buf(&text);
+        let s = b.snapshot();
+        assert!(s.len() > 128, "the text spans several chunks");
+        let boundaries: Vec<u32> = (0..=s.len()).filter(|&o| text.is_char_boundary(o as usize)).collect();
+        for &start in &boundaries {
+            for &end in boundaries.iter().filter(|&&e| e >= start).step_by(7) {
+                let joined: String = s.chunks(start..end).collect();
+                assert_eq!(joined, s.slice(start..end), "chunks of {start}..{end} match the slice");
+            }
+        }
+        assert_eq!(s.chunks(1..1).count(), 0, "an empty range yields no chunk");
+        assert_eq!(s.chunks(0..u32::MAX).collect::<String>(), text, "an over-long range is the whole text");
+        #[allow(clippy::reversed_empty_ranges)] // the inverted range is the input under test
+        let inverted = 9..3;
+        assert_eq!(s.chunks(inverted).count(), 0, "an inverted range yields nothing");
+        let emoji = text.find('😀').expect("the text has an emoji") as u32;
+        assert_eq!(
+            s.chunks(emoji + 1..emoji + 3).collect::<String>(),
+            s.slice(emoji..emoji + 4),
+            "mid-char ends snap outward"
+        );
+    }
+
