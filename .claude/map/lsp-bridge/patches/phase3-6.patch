+            ("a*b", "a\\*b"),
+            ("**x**", "\\*\\*x\\*\\*"),
+            ("`c`", "\\`c\\`"),
+            ("a\\b", "a\\\\b"),
+            ("expected *mut T, found `&T`", "expected \\*mut T, found \\`&T\\`"),
+            ("", ""),
+        ] {
+            assert_eq!(escape_markdown(raw), escaped, "{raw:?}");
