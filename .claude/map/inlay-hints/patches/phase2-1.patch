+    fn rows_folds_is_the_documents_fold_map() {
+        let doc = doc_with_folds("a {\nb\n}\nc\n", &[2]);
+        assert_eq!(*doc.rows().folds(), *doc.fold_map(), "the view reads the cached fold map");
