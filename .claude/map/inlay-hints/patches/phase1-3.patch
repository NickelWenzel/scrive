+fn type_hint(i: usize) -> inlay::Hint {
+    let label = vec![inlay::Part::new(": u8", inlay::Link::None)];
+    inlay::Hint::new(inlay::Kind::Type, label, inlay::Key::new(i as u64)).expect("a visible label")
+}
