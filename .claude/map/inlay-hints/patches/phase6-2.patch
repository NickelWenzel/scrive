+    let key = |i: usize| hints[i].hint().key();
+    let typed = inlay::Hint::new(
+        inlay::Kind::Type,
+        vec![
+            inlay::Part::new(": ", inlay::Link::None),
+            inlay::Part::new("i32", inlay::Link::Jumps),
